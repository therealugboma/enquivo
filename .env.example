# Optional. Leave empty to use the built-in offline assistant (default).
# If set, the assistant asks OpenAI for answers it can't match locally, grounded in the knowledge base.
# NOTE: a key in a VITE_ variable is exposed to the browser — only use this for private local demos.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
